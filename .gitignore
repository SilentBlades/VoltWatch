# ==============================================================================
# VoltWatch - Monorepo Git Ignore Configuration
# ==============================================================================

# --- Build Artifacts & Binaries ---
build/
firmware/build/
bin/
firmware/bin/
firmware/test/bin/
out/
dist/
*.o
*.obj
*.a
*.so
*.dylib
*.elf
*.bin
*.hex
*.map
*.d
*.lst
*.tmp
*.cache

# --- Embedded & Arduino Toolchains ---
.pio/
firmware/.pio/
firmware/.pioenvs/
firmware/.piolibdeps/
.pioenvs/
.piolibdeps/
.clangd/
.ccls-cache/
compile_commands.json
*.gcno
*.gcda
*.gcov
coverage/

# --- IDE & Editor Settings ---
.idea/
*.iml
*.ipr
*.iws

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# --- Secrets & Hardware Overrides ---
# Never commit credentials or local hardware overrides
secrets.h
firmware/include/secrets.h
firmware/**/secrets.h
include/secrets.h
**/secrets.h
include/config.local.h
firmware/include/config.local.h
*.local.h
*.env
.env
.env.*

# --- Operating System Files ---
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
*~

# --- Hardware CAD / EDA Backups ---
*.bak
*-bak
hardware/exports/

# --- Logs & Telemetry Captures ---
*.log
logs/
monitor.log
